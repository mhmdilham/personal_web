---
// ============================================================================
// FAQ.astro (GEO / AI Answer Engine & User Clarity)
// Pertanyaan terstruktur berbasis intent pengguna dan pencarian AI.
// Menggunakan gaya Industrial Focus / Pinned Poster.
// ============================================================================

const faqs = [
  {
    question: "Siapa Muhammad Ilham dan apa fokus keahlian utamanya?",
    answer: "Muhammad Ilham adalah mahasiswa S1 Informatika di Universitas Teknologi Yogyakarta (UTY) dengan fokus penjurusan Web & Mobile Development. Fondasi teknisnya berakar dari SMK N 1 Saptosari (Teknik Komputer & Jaringan) serta pengalaman praktik kerja lapangan di Gmedia."
  },
  {
    question: "Bagaimana latar belakang teknisi fiber optic memperkuat rekayasa perangkat lunak?",
    answer: "Pengalaman instalasi dan penanganan jaringan internet lapangan di Gmedia memberikan perspektif infrastruktur fisik yang nyata. Pemahaman tentang latensi, paket transmisi, dan keterbatasan bandwidth diterjemahkan ke dalam penulisan kode antarmuka digital yang berbobot ringan, cepat dimuat, dan hemat sumber daya."
  },
  {
    question: "Apa saja teknologi utama yang digunakan dalam pengembangan aplikasi?",
    answer: "Untuk Web Development, teknologi utama mencakup Astro, Tailwind CSS, TypeScript/JavaScript, dan HTML5 semantik dengan skor performa PageSpeed maksimal. Untuk Mobile Development, fokus pada pengembangan cross-platform menggunakan Flutter dan Dart."
  },
  {
    question: "Apakah Muhammad Ilham terbuka untuk kesempatan magang (internship) atau kolaborasi proyek?",
    answer: "Ya. Saat ini Muhammad Ilham aktif membuka diri untuk kesempatan magang industri di bidang Web Development atau Mobile Development, serta terbuka untuk diskusi proyek teknis yang menuntut kedisiplinan dan keandalan sistem."
  }
];
---

<section id="faq" class="py-20 border-b border-brand-border scroll-mt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 mb-12 border-b border-brand-border">
      <div>
        <div class="font-mono text-xs text-brand-orange uppercase tracking-widest mb-2">
          // 05. TANYA JAWAB TEKNIS
        </div>
        <h2 class="font-headline text-3xl sm:text-5xl text-white tracking-tight uppercase">
          PERTANYAAN UMUM & JAWABAN TEKNIS
        </h2>
      </div>
      <p class="text-sm font-mono text-brand-muted max-w-md">
        Jawaban ringkas dan faktual seputar kapabilitas teknis, latar belakang lapangan, dan kesiapan kolaborasi.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {faqs.map((faq, index) => (
        <article class="p-6 sm:p-8 bg-brand-surface border-l-2 border-brand-orange flex flex-col justify-between">
          <div>
            <div class="font-mono text-xs text-brand-orange font-bold mb-3">
              Q0{index + 1} // FAQ
            </div>
            <h3 class="font-headline text-xl sm:text-2xl text-white leading-snug">
              {faq.question}
            </h3>
            <p class="mt-4 text-sm sm:text-base text-slate-300 leading-relaxed">
              {faq.answer}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-brand-border/60 font-mono text-xs text-brand-muted">
            STATUS: JAWABAN RESMI TERVERIFIKASI
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
