---
// ============================================================================
// Footer.astro (Taste Skill Editorial Version)
// Penutup struktural dengan kontras tinggi (Orange & Black field).
// ============================================================================

const currentYear = new Date().getFullYear();

const socials = [
  { label: "GITHUB", href: "https://github.com/mhmdilham" },
  { label: "LINKEDIN", href: "https://www.linkedin.com/in/in-mhmdilham" },
  { label: "EMAIL", href: "mailto:muhammadilham8353@gmail.com" },
];
---

<footer id="kontak" class="bg-brand-dark pt-20 pb-12 scroll-mt-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Bagian Aksi Kontak (Hero Card Kontak & Form Pageclip) -->
    <div class="p-5 sm:p-10 lg:p-12 bg-brand-surface border-l-4 border-brand-orange mb-12 sm:mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        
        <!-- Kolom Kiri: Teks & Info Langsung -->
        <div class="lg:col-span-5 flex flex-col justify-between h-full">
          <div>
            <div class="font-mono text-xs text-brand-orange uppercase tracking-widest mb-3">
              // HUBUNGI SAYA
            </div>
            <h2 class="font-headline text-2xl sm:text-4xl text-white uppercase leading-[0.95]">
              SEDANG MENCARI TALENTA DENGAN KETEKUNAN TINGGI?
            </h2>
            <p class="mt-4 text-sm text-slate-300 leading-relaxed">
              Saya selalu terbuka untuk diskusi seputar Web & Mobile Development, peluang kerja sama proyek, maupun tawaran program magang. Silakan kirimkan pesan langsung melalui formulir di samping.
            </p>
          </div>

          <div class="mt-6 sm:mt-8 pt-5 sm:pt-6 border-t border-brand-border/60 space-y-2 font-mono text-xs text-slate-400">
            <div>
              <span class="text-brand-orange font-bold">EMAIL LANGSUNG:</span>
              <a href="mailto:muhammadilham8353@gmail.com" class="ml-2 text-slate-200 hover:text-brand-orange transition-colors underline underline-offset-4 break-all">
                muhammadilham8353@gmail.com
              </a>
            </div>
            <div>
              <span class="text-brand-orange font-bold">LINKEDIN:</span>
              <a href="https://www.linkedin.com/in/in-mhmdilham" target="_blank" rel="noopener noreferrer" class="ml-2 text-slate-200 hover:text-brand-orange transition-colors">
                in/in-mhmdilham ↗
              </a>
            </div>
          </div>
        </div>

        <!-- Kolom Kanan: Form Kontak Terhubung ke Pageclip -->
        <div class="lg:col-span-7 bg-brand-dark/70 p-5 sm:p-8 border border-brand-border">
          <form 
            action="https://send.pageclip.co/UB2BBLZwSbdqCBF3G1WEynkdv2TxsFD6/contact_me" 
            class="pageclip-form space-y-4" 
            method="post"
          >
            <div>
              <label for="name" class="block font-mono text-[11px] text-slate-300 uppercase tracking-wider mb-1.5">
                NAMA LENGKAP / INSTANSI <span class="text-brand-orange">*</span>
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                autocomplete="name"
                required 
                placeholder="Nama Anda atau Perusahaan" 
                class="w-full bg-brand-surface border border-brand-border px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-orange transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block font-mono text-[11px] text-slate-300 uppercase tracking-wider mb-1.5">
                ALAMAT EMAIL <span class="text-brand-orange">*</span>
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                autocomplete="email"
                required 
                placeholder="email@domain.com" 
                class="w-full bg-brand-surface border border-brand-border px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-orange transition-colors"
              />
            </div>

            <div>
              <label for="message" class="block font-mono text-[11px] text-slate-300 uppercase tracking-wider mb-1.5">
                PESAN / TAWARAN <span class="text-brand-orange">*</span>
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required 
                placeholder="Tuliskan pesan, penawaran magang, atau diskusi proyek Anda di sini..." 
                class="w-full bg-brand-surface border border-brand-border px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brand-orange transition-colors resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="pageclip-form__submit pageclip-form__submit--dark-loader w-full sm:w-auto px-8 py-3.5 text-xs font-subheadline font-bold bg-brand-orange text-brand-dark hover:bg-brand-orange-hover transition-colors tracking-wider uppercase cursor-pointer"
            >
              <span>KIRIM PESAN LANGSUNG ↗</span>
            </button>
          </form>
        </div>

      </div>
    </div>

    <!-- Quiet Single Line Footer (Responsif Mobile & Desktop) -->
    <div class="pt-8 border-t border-brand-border flex flex-col md:flex-row items-center justify-between gap-5 font-mono text-xs text-brand-muted text-center md:text-left">
      <div class="flex flex-col sm:flex-row items-center gap-1.5 sm:gap-2 leading-relaxed">
        <span class="text-slate-300">© {currentYear} MUHAMMAD ILHAM.</span>
        <span class="hidden sm:inline text-brand-muted">•</span>
        <span class="text-[11px] sm:text-xs text-slate-400">INFORMATIKA FST UNIVERSITAS TEKNOLOGI YOGYAKARTA</span>
      </div>

      <div class="flex items-center justify-center gap-6 tracking-wider">
        {socials.map((link) => (
          <a 
            href={link.href} 
            target="_blank" 
            rel="noopener noreferrer"
            class="hover:text-brand-orange transition-colors py-1"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

  </div>
</footer>

<style is:global>
  /* Pageclip Core Styles (Inlined untuk menghilangkan request blocking eksternal) */
  .pageclip-form { position: relative; }
  .pageclip-form__submit { position: relative; }
  .pageclip-form__submit:after {
    display: inline-block;
    position: relative;
    text-indent: -9999em;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-left: 3px solid #fff;
    transform: scale(0.01) translateZ(0);
    border-radius: 50%;
    width: 20px;
    height: 20px;
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    margin-left: -10px;
    margin-top: -10px;
    z-index: 2;
  }
  .pageclip-form__submit.pageclip-form__submit--dark-loader:after {
    border-color: rgba(5, 15, 22, 0.25);
    border-left-color: #050F16;
  }
  .pageclip-form__submit.pageclip-form__submit--start-loading:after { animation: .1s linear none a; }
  .pageclip-form__submit.pageclip-form__submit--start-loading>span { animation: .1s linear none c; }
  .pageclip-form__submit.pageclip-form__submit--loading:after { transform: translateZ(0); animation: 1.2s linear infinite d; }
  .pageclip-form__submit.pageclip-form__submit--loading>span { opacity: 0; }
  .pageclip-form__submit.pageclip-form__submit--end-loading:after { animation: .1s linear none b; }
  .pageclip-form__submit.pageclip-form__submit--end-loading>span { animation: .1s linear reverse c; }
  @keyframes a { 0% { transform: scale(0.01) translateZ(0); } 50% { transform: scale(1.2) translateZ(0); } to { transform: scale(1) translateZ(0); } }
  @keyframes b { 0% { transform: scale(1) translateZ(0); } to { transform: scale(0.01) translateZ(0); } }
  @keyframes c { 0% { opacity: 1; } to { opacity: 0; } }
  @keyframes d { 0% { transform: rotate(0deg); } to { transform: rotate(1turn); } }

  /* Kustomisasi tampilan feedback sukses Pageclip untuk tema gelap */
  .pageclip-form__success {
    position: absolute;
    top: -1px;
    left: -1px;
    right: -1px;
    bottom: -1px;
    text-align: center;
    background: rgba(10, 24, 34, 0.96) !important;
    border: 1px solid #FF7A1F !important;
    color: #ffffff !important;
    padding: 2rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .pageclip-form__success__message {
    font-family: 'Archivo', sans-serif !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.05em;
    text-transform: uppercase !important;
    color: #FF7A1F !important;
    animation: .3s linear none a;
  }
</style>
