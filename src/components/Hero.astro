---
// ============================================================================
// Hero.astro (Taste Skill Direction: The Pinned Poster / Industrial Focus)
// - Headline maksimal 2 baris
// - Tipografi Archivo Condensed raksasa
// - Menghubungkan kisah riil Gmedia & UTY
// ============================================================================
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 border-b border-brand-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    <!-- Baris Meta Data Teknis Paling Atas (Industrial Top Strip) -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-brand-border/60 text-xs font-mono text-brand-muted">
      <div class="flex items-center gap-3">
        <span class="text-brand-orange font-bold">LOC:</span> YOGYAKARTA, ID
        <span class="text-slate-700">|</span>
        <span class="text-brand-orange font-bold">EDU:</span> UTY INFORMATIKA
      </div>
      <div class="flex items-center gap-2">
        <span class="text-brand-orange font-bold">SPEC:</span> WEB & MOBILE APPLICATION
      </div>
    </div>

    <!-- Konten Utama Hero -->
    <div class="max-w-5xl">
      
      <!-- Headline Maksimal 2 Baris (Taste Skill Rule: Headlines 2 lines or fewer) -->
      <h1 class="font-headline text-4xl sm:text-6xl md:text-7xl lg:text-8xl tracking-tight text-white uppercase leading-[0.92]">
        KODE WEB & MOBILE DENGAN <br class="hidden sm:inline" />
        <span class="text-brand-orange">INSTING JARINGAN NYATA.</span>
      </h1>

      <!-- Ringkasan Fakta Lapangan (3 Baris Struktural) -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        
        <!-- Kolom Fakta Teknis -->
        <div class="md:col-span-6 space-y-2.5 font-mono text-xs sm:text-sm text-slate-300 border-l-2 border-brand-orange pl-4">
          <div><strong class="text-white font-bold">AKADEMIK:</strong> S1 Informatika UTY (Penjurusan Web & Mobile)</div>
          <div><strong class="text-white font-bold">LAPANGAN:</strong> Eks-Teknisi Jaringan Gmedia</div>
          <div><strong class="text-white font-bold">ALMAMATER:</strong> SMK N 1 Saptosari (Teknik Komputer & Jaringan)</div>
        </div>

        <!-- Kolom Pernyataan Singkat & CTA -->
        <div class="md:col-span-6 flex flex-col justify-between">
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
            Menghubungkan pemahaman fisik transmisi data kabel serat optik dengan rekayasa antarmuka digital yang cepat, responsif, dan siap produksi.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a 
              href="#proyek" 
              class="px-6 py-3 text-xs font-subheadline font-bold bg-white text-brand-dark hover:bg-brand-orange hover:text-white transition-colors uppercase tracking-wider"
            >
              Lihat Proyek Pilihan ↓
            </a>

            <a 
              href="#pengalaman" 
              class="px-5 py-3 text-xs font-subheadline font-bold text-slate-300 hover:text-brand-orange transition-colors uppercase tracking-wider flex items-center gap-1.5"
            >
              Rekam Jejak Lapangan →
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
