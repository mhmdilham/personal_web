---
// ============================================================================
// Hero.astro (Taste Skill Direction: The Pinned Poster / Industrial Focus)
// - Headline maksimal 2 baris
// - Tipografi Archivo Condensed raksasa
// - Menghubungkan kisah riil Gmedia & UTY
// ============================================================================
---

<section class="relative pt-10 pb-16 sm:pt-16 sm:pb-24 md:pt-20 md:pb-28 border-b border-brand-border overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-8">
    
    {/* Baris Meta Data Teknis Paling Atas (Industrial Top Strip) */}
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-4 pb-4 sm:pb-6 mb-6 sm:mb-8 border-b border-brand-border/60 text-xs font-mono text-brand-muted">
      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <span><strong class="text-brand-orange">LOC:</strong> YOGYAKARTA, ID</span>
        <span class="text-slate-700 hidden sm:inline">|</span>
        <span><strong class="text-brand-orange">EDU:</strong> UTY INFORMATIKA</span>
      </div>
      <div class="flex items-center gap-2">
        <span><strong class="text-brand-orange">SPEC:</strong> WEB & MOBILE APPLICATION</span>
      </div>
    </div>

    {/* Konten Utama Hero */}
    <div class="max-w-5xl">
      
      {/* Headline Responsif: 2 Baris Bersih di Desktop, 4 Baris Simetris di Mobile */}
      <h1 class="font-headline text-3xl xs:text-4xl sm:text-5xl md:text-6xl lg:text-7xl tracking-tight uppercase leading-[0.96] sm:leading-[0.92] max-w-full">
        <span class="sr-only">Muhammad Ilham — </span>
        <span class="block text-white">
          DARI TEKNISI <br class="sm:hidden" />JARINGAN LAPANGAN
        </span>
        <span class="block text-brand-orange mt-2 sm:mt-1">
          KE PENGEMBANGAN <br class="sm:hidden" />WEB & MOBILE.
        </span>
      </h1>

      {/* Ringkasan Fakta Lapangan (3 Baris Struktural) */}
      <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
        
        {/* Kolom Fakta Teknis */}
        <div class="md:col-span-6 space-y-2.5 font-mono text-xs sm:text-sm text-slate-300 border-l-2 border-brand-orange pl-4 break-words">
          <div><strong class="text-white font-bold">AKADEMIK:</strong> S1 Informatika UTY (Penjurusan Web & Mobile)</div>
          <div><strong class="text-white font-bold">LAPANGAN:</strong> Eks-Teknisi Jaringan Gmedia</div>
          <div><strong class="text-white font-bold">ALMAMATER:</strong> SMK N 1 Saptosari (Teknik Komputer & Jaringan)</div>
        </div>

        {/* Kolom Pernyataan Singkat & CTA */}
        <div class="md:col-span-6 flex flex-col justify-between">
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed break-words">
            Menghubungkan pemahaman fisik transmisi data kabel serat optik dengan rekayasa antarmuka digital yang cepat, responsif, dan siap produksi.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a 
              href="#proyek" 
              role="button"
              aria-label="Jelajahi Proyek Web & Mobile Pilihan"
              class="w-full sm:w-auto text-center px-6 py-3 text-xs font-subheadline font-bold bg-white text-brand-dark hover:bg-brand-orange hover:text-white transition-colors uppercase tracking-wider"
            >
              Jelajahi Proyek Pilihan ↓
            </a>

            <a 
              href="#pengalaman" 
              role="button"
              aria-label="Lihat Rekam Jejak Lapangan"
              class="w-full sm:w-auto text-center justify-center px-5 py-3 text-xs font-subheadline font-bold text-slate-300 hover:text-brand-orange transition-colors uppercase tracking-wider flex items-center gap-1.5"
            >
              Rekam Jejak Lapangan →
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
