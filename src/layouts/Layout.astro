---
// ============================================================================
// Layout.astro
// Master Layout mengikuti arahan resmi Taste Skill: "The Pinned Poster"
// Tipografi utama: Archivo Variable (Narrow & Heavy Display + Normal Body)
// Palet: Deep Blue-Black (#050F16) & Hot Signal Orange (#FF7A1F)
// ============================================================================

import '@fontsource-variable/archivo/standard.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "MUHAMMAD ILHAM — INFORMATIKA UTY // WEB & MOBILE // FIBER ROOTS",
  description = "Personal website & portofolio teknis Muhammad Ilham. Mahasiswa Informatika UTY penjurusan Web & Mobile dengan latar belakang lapangan fiber optic Gmedia."
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Preload Critical Self-Hosted Font to eliminate Network Chain and Layout Shift (CLS) -->
    <link 
      rel="preload" 
      href="/_astro/archivo-latin-standard-normal.DY7AcnAa.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
  </head>
  <body class="bg-brand-dark text-slate-100 min-h-screen relative overflow-x-hidden selection:bg-brand-orange selection:text-brand-dark">
    <!-- Grid Teknis Halus (Taste Skill: Architecture of the ground) -->
    <div class="fixed inset-0 industrial-grid pointer-events-none z-0 opacity-80"></div>
    
    <!-- Konten Utama Halaman -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <!-- Pageclip JavaScript SDK (Loaded on idle for 0ms initial main-thread blocking) -->
    <script is:inline>
      if ('requestIdleCallback' in window) {
        requestIdleCallback(() => {
          const s = document.createElement('script');
          s.src = '/pageclip.js';
          s.defer = true;
          document.body.appendChild(s);
        }, { timeout: 2000 });
      } else {
        window.addEventListener('load', () => {
          setTimeout(() => {
            const s = document.createElement('script');
            s.src = '/pageclip.js';
            s.defer = true;
            document.body.appendChild(s);
          }, 800);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
