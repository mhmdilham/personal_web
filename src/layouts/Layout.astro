---
// ============================================================================
// Layout.astro
// Master Layout mengikuti arahan resmi Taste Skill: "The Pinned Poster"
// Tipografi utama: Archivo Variable (Narrow & Heavy Display + Normal Body)
// Palet: Deep Blue-Black (#050F16) & Hot Signal Orange (#FF7A1F)
// ============================================================================

import '@fontsource-variable/archivo/standard.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Muhammad Ilham — Web & Mobile Developer | Informatika UTY",
  description = "Portofolio Muhammad Ilham: Web & Mobile Developer mahasiswa Informatika UTY Yogyakarta. Jelajahi proyek Astro & Flutter, rekam jejak, dan peluang magang."
} = Astro.props;

const siteUrl = "https://mhmdilham.web.id";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og-image.png`;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Muhammad Ilham",
      "url": siteUrl,
      "jobTitle": "Web & Mobile Developer",
      "description": description,
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Universitas Teknologi Yogyakarta"
        },
        {
          "@type": "EducationalOrganization",
          "name": "SMK Negeri 1 Saptosari"
        }
      ],
      "knowsAbout": [
        "Web Development",
        "Mobile Application Development",
        "Astro",
        "Tailwind CSS",
        "Flutter",
        "Dart",
        "Fiber Optic Networks",
        "Computer Network Engineering"
      ],
      "sameAs": [
        "https://github.com/mhmdilham",
        "https://www.linkedin.com/in/in-mhmdilham",
        "https://www.instagram.com/ig_mhmdilham",
        "https://www.facebook.com/fbmhmdilham/"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Muhammad Ilham — Web & Mobile Developer",
      "description": description,
      "publisher": {
        "@id": `${siteUrl}/#person`
      },
      "inLanguage": "id-ID",
      "datePublished": "2026-10-16T10:00:00+07:00",
      "dateModified": "2026-10-22T17:40:00+07:00"
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": siteUrl
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Muhammad Ilham" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#050F16" />
    <meta name="color-scheme" content="dark" />

    {/* Security Hardening & Content Security Policy (Allows Pageclip & Cloudflare Insights Analytics) */}
    <meta 
      http-equiv="Content-Security-Policy" 
      content="default-src 'self'; script-src 'self' https://send.pageclip.co https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://send.pageclip.co https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self' https://send.pageclip.co;" 
    />

    {/* Canonical URL */}
    <link rel="canonical" href={canonicalUrl} />

    {/* Favicon & Touch Icons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Muhammad Ilham" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Muhammad Ilham — Mahasiswa Informatika UTY | Web & Mobile Developer" />

    {/* Twitter / X Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Structured Data JSON-LD (Schema.org for SEO & AI Answer Engines) */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schemaData)} />

    {/* Preload Critical Self-Hosted Font to eliminate Network Chain and Layout Shift (CLS) */}
    <link 
      rel="preload" 
      href="/_astro/archivo-latin-standard-normal.DY7AcnAa.woff2" 
      as="font" 
      type="font/woff2" 
      crossorigin 
    />
  </head>
  <body class="bg-brand-dark text-slate-100 min-h-screen min-h-[100dvh] relative overflow-x-clip selection:bg-brand-orange selection:text-brand-dark">
    {/* Aksesibilitas: Skip-to-content link untuk pengguna keyboard & screen reader (Standar WCAG / Scanner) */}
    <a 
      id="skip-link"
      href="#main-content" 
      aria-label="Skip to main content / Lewati ke konten utama"
      class="skip-link sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-orange focus:text-brand-dark focus:font-bold focus:text-xs focus:tracking-wider focus:uppercase focus:outline-none focus:ring-2 focus:ring-white"
    >
      Skip to content / Lewati ke Konten Utama ↓
    </a>
    {/* Grid Teknis Halus (Taste Skill: Architecture of the ground) */}
    <div class="fixed inset-0 industrial-grid pointer-events-none z-0 opacity-80"></div>
    
    {/* Konten Utama Halaman */}
    <div class="relative z-10 flex flex-col min-h-screen min-h-[100dvh]">
      <slot />
    </div>

    {/* Pageclip JavaScript SDK Loader (External script to strictly satisfy CSP without unsafe-inline) */}
    <script src="/init-form.js" defer></script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
